---
import Layout from '@/layouts/Layout.astro';
import { Hero } from '@/components/site/Hero';
import { SiteFooter } from '@/components/site/SiteFooter';
import { SiteHeader } from '@/components/site/SiteHeader';
import { StrataGrid } from '@/components/site/StrataGrid';
import { StrataList } from '@/components/site/StrataList';
import { Toolbox } from '@/components/site/Toolbox';
import { profile, rootSet, site, skills } from '@/lib/content';
import { buildStrata } from '@/lib/timeline';

const strata = buildStrata();
const showToolbox = site.sections.toolbox && skills.length > 0;

const nav = [
  { label: 'Map', href: '#map' },
  ...(showToolbox ? [{ label: 'Toolbox', href: '#toolbox' }] : []),
  { label: 'Contact', href: '#contact' },
];
---

<Layout>
  <SiteHeader root={rootSet} profile={profile} nav={nav} />
  <main id="top" class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-16">
    <section
      id="map"
      aria-labelledby="name"
      class="relative mt-8 rounded-[28px] border-[1.5px] border-[#e6e8ec] px-5 pb-10 pt-10 sm:px-8 lg:rounded-[48px] lg:px-10 lg:pb-14 lg:pt-12"
    >
      <span class="absolute -top-3 left-6 bg-background px-2.5 font-mono text-sm font-semibold lg:left-12">
        {rootSet.symbol} = {rootSet.name}
      </span>
      <Hero profile={profile} root={rootSet} topSets={strata.topSets} readingNote={site.timeline.readingNote} />
      <StrataGrid strata={strata} />
      <StrataList strata={strata} root={rootSet} />
    </section>

    {showToolbox && <Toolbox groups={skills} />}
    <SiteFooter profile={profile} root={rootSet} asOf={strata.asOf} />
  </main>
</Layout>
